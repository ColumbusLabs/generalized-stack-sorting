  change BiPoly.mul (h4e2.toBi mapPolyEnv) (h4e65.toBi mapPolyEnv)=h4p66
  rw [h4n2, h4n65]
  exact h4n66_arithmetic

#print axioms h4n66_arithmetic
end StackSorting.RationalLift

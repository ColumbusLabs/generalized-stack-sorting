import FiniteMatrix
noncomputable section
namespace StackSorting.FiniteGraph
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000

structure Chart (R : Type) [Lean.Grind.CommRing R] where
  g : R
  i : R
  p : R
  q : R
  s : R
  c : R
  o : R
  gi : R
  qi : R
  si : R
  half : R
  g_unit : g*gi=1
  q_unit : q*qi=1
  s_unit : s*si=1
  half_unit : 2*half=1

variable {R : Type} [Lean.Grind.CommRing R]

inductive RingExpr where
  | int : Int → RingExpr
  | var : Nat → RingExpr
  | add : RingExpr → RingExpr → RingExpr
  | mul : RingExpr → RingExpr → RingExpr
  | pow : RingExpr → Nat → RingExpr

attribute [local instance] Lean.Grind.Ring.intCast

def exprEval (env : Nat → R) : RingExpr → R
  | .int c => IntCast.intCast c
  | .var i => env i
  | .add a b => exprEval env a+exprEval env b
  | .mul a b => exprEval env a*exprEval env b
  | .pow a n => exprEval env a^n

def chartVars (y : Chart R) (beta : Vec R 6) : Nat → R
  | 0 => y.g
  | 1 => y.i
  | 2 => y.p
  | 3 => y.q
  | 4 => y.s
  | 5 => y.c
  | 6 => y.o
  | 7 => y.gi
  | 8 => y.qi
  | 9 => y.si
  | 10 => y.half
  | 11 => beta 0
  | 12 => beta 1
  | 13 => beta 2
  | 14 => beta 3
  | 15 => beta 4
  | 16 => beta 5
  | _ => 0


theorem original_allwordzero (y : Chart R) (x scale : R)
    (hs : SixScalarEquations y x (betaDirection y scale))
    (f : Family) (a : Letter) (w : List Letter) :
    terminal19 (kappa y x (betaDirection y scale))
      (fun j => litnu19 y (betaDirection y scale) j 0)
      (run19 (transitions y) (suffix19 y (betaDirection y scale))
        (deleted19 y) w (initial19 y (betaDirection y scale) f a))=0 := by
  rw [quotient_output (litS y (betaDirection y scale)) _ _ _
    (literal_quotient_terminal y (betaDirection y scale))]
  rw [quotient_run (transitions y) (suffix19 y (betaDirection y scale))
    (deleted19 y) (suffix9 y (betaDirection y scale)) (deleted9 y (betaDirection y scale))
    (litS y (betaDirection y scale)) (literal_quotient_intertwines y (betaDirection y scale))
    (literal_deleted_quotient y (betaDirection y scale))]
  rw [literal_initial_projection]
  exact literal_allwordzero y x scale hs f a w


  rw [dz2n813_norm]
  decide

theorem staged_direction_zero (y : Chart R) (scale : R) :
    exprEval (chartVars y (betaDirection y scale)) stagedDirectionNumerator=0 := by
  have h := reflected_polynomial_identity (directionContext y scale)
    (substituteRing directionSubstitution stagedDirectionNumerator) (.int 0) staged_direction_normalized
  rw [eval_directionSubstitution] at h
  simpa only [exprEval, Lean.Grind.Ring.intCast_zero] using h


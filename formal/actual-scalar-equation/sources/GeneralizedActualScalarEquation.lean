/-! Final specialization of the actual-count theorem to the literal scalar
branch. This module requires the complete finite graph and scalar lift objects;
no outstanding mathematical obligation is converted into a hypothesis here. -/
noncomputable section
namespace StackSorting.Generalized.Decorated.SignedCompletion
open StackSorting.CauchyRing StackSorting.FiniteGraph StackSorting.RationalLift
open StackSorting.FPSDivision StackSorting.ConcreteScalar

theorem literal_G_original_residual (f : Family) (a : Letter) (word : List Letter) :
    terminal19 (kappa liftedChart X lifted_beta) (fun i => litnu19 liftedChart lifted_beta i 0)
      (run19 (transitions liftedChart) (suffix19 liftedChart lifted_beta) (deleted19 liftedChart)
        word (initial19 liftedChart lifted_beta f a))=0 := by
  have hs : SixScalarEquations liftedChart X
      (betaDirection liftedChart (normalizedScale (inv lifted_D) (inv lifted_norm))) := by
    rw [literal_G_graph_beta]
    exact literal_G_beta_seven.1
  have hz := original_allwordzero liftedChart X
    (normalizedScale (inv lifted_D) (inv lifted_norm)) hs f a word
  rw [literal_G_graph_beta] at hz
  exact hz

/-- Every coefficient of the selected literal branch is the number of distinct
permutations generated by the unrestricted-height physical machine with
insertion and removal among the top three positions. -/
theorem literal_G_counts (n : Nat) : G n = (ActualCounting.threeThreeCounts n : Rat) := by
  have hc := matrixGeneratingFunction_actual_counts liftedChart lifted_beta
    literal_G_beta_seven literal_G_beta_boundary literal_G_original_residual n
  have hg : G=generatingFunction X lifted_beta := by
    rw [root_normalization]
    exact lifted_output_beta
  rw [hg]
  exact hc

/-- The unchanged 69-term Q holds coefficientwise for the actual counting
series. This is an all-length identity, not a finite prefix comparison. -/
theorem actual_counts_literalQ :
    literalQ.eval (fun _ => fun n => (ActualCounting.threeThreeCounts n : Rat)) =
      (fun _ => (0 : Rat)) := by
  have he : (fun n => (ActualCounting.threeThreeCounts n : Rat))=G.coeff := by
    funext n
    exact (literal_G_counts n).symm
  rw [he]
  exact literalQ_G_all_coefficients

#print axioms literal_G_counts
#print axioms actual_counts_literalQ
end StackSorting.Generalized.Decorated.SignedCompletion

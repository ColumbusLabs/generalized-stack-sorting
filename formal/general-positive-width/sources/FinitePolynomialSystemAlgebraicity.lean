import JacobianAlgebraicity

/-!
A finite square polynomial system with unit evaluated Jacobian has algebraic coordinates, via its actual quotient presentation.

The original source passed the independent final 607-module review on 2026-10-14.
This publication revision, dated 2026-10-14, changes only this header;
declarations and proofs are unchanged.
Original accepted source SHA-256: 38b78eb73bdfe1fade212a9c3b830b0f4af56f80dd6581c8637bbee2ef77e695
-/
namespace StackSorting.GeneralAlgebraicity
open Algebra MvPolynomial
noncomputable section

variable {K L ι : Type*} [Field K] [CommRing L] [Algebra K L]
  [Fintype ι] [DecidableEq ι]

/-- The full square Jacobian, with variables indexing rows and relations columns. -/
def systemJacobian (f : ι → MvPolynomial ι K) : MvPolynomial ι K :=
  Matrix.det (fun i j => MvPolynomial.pderiv i (f j))

def relationIdeal (f : ι → MvPolynomial ι K) : Ideal (MvPolynomial ι K) :=
  Ideal.span (Set.range f)

abbrev RelationQuotient (f : ι → MvPolynomial ι K) :=
  MvPolynomial ι K ⧸ relationIdeal f

/-- Evaluation factors through precisely the ideal generated by the equations. -/
def solutionHom (f : ι → MvPolynomial ι K) (a : ι → L)
    (ha : ∀ i, MvPolynomial.aeval a (f i) = 0) : RelationQuotient f →ₐ[K] L :=
  Ideal.Quotient.liftₐ (relationIdeal f) (MvPolynomial.aeval a) (by
    intro p hp
    have hI : relationIdeal f ≤ RingHom.ker (MvPolynomial.aeval a).toRingHom := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      exact ha i
    exact hI hp)

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem solutionHom_mk (f : ι → MvPolynomial ι K) (a : ι → L)
    (ha : ∀ i, MvPolynomial.aeval a (f i) = 0) (p : MvPolynomial ι K) :
    solutionHom f a ha (Ideal.Quotient.mk (relationIdeal f) p) = MvPolynomial.aeval a p := by
  rfl

/-- The identity relation-to-variable map is a finite square presentation. -/
def systemPresentation (f : ι → MvPolynomial ι K) :
    PreSubmersivePresentation K (RelationQuotient f) ι ι :=
  PreSubmersivePresentation.naive (v := f) id Function.injective_id

theorem systemPresentation_jacobian (f : ι → MvPolynomial ι K) :
    (systemPresentation f).jacobian =
      Ideal.Quotient.mk (relationIdeal f) (systemJacobian f) := by
  have hM : (systemPresentation f).jacobiMatrix =
      fun i j => MvPolynomial.pderiv i (f j) := by
    funext i j
    rw [PreSubmersivePresentation.jacobiMatrix_apply]
    rfl
  rw [PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hM]
  rfl

theorem finitePolynomialSystem_integral (f : ι → MvPolynomial ι K) (a : ι → L)
    (ha : ∀ i, MvPolynomial.aeval a (f i) = 0)
    (hj : IsUnit (MvPolynomial.aeval a (systemJacobian f))) (i : ι) :
    IsIntegral K (a i) := by
  have hJ : IsUnit (solutionHom f a ha (systemPresentation f).jacobian) := by
    rw [systemPresentation_jacobian, solutionHom_mk]
    exact hj
  have h := squarePresentation_integral_image (systemPresentation f)
    (solutionHom f a ha) hJ (Ideal.Quotient.mk (relationIdeal f) (X i))
  simpa using h

theorem finitePolynomialSystem_algebraic (f : ι → MvPolynomial ι K) (a : ι → L)
    (ha : ∀ i, MvPolynomial.aeval a (f i) = 0)
    (hj : IsUnit (MvPolynomial.aeval a (systemJacobian f))) (i : ι) :
    IsAlgebraic K (a i) :=
  (finitePolynomialSystem_integral f a ha hj i).isAlgebraic

#print axioms finitePolynomialSystem_integral
#print axioms finitePolynomialSystem_algebraic
end
end StackSorting.GeneralAlgebraicity

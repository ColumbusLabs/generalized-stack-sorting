import SourceRectangle

namespace StackSorting.GraphWidth.UCurve.PlaneGrid

/-- Adjacency generated by vertex rotation and edge reversal. -/
def MapStep {w h} (hw : 0<w) (hh : 0<h) (d e : Dart w h) : Prop :=
  OrbitStep (Dart.rotate hw hh) d e ∨ OrbitStep (@Dart.reverse w h) d e

theorem mapStep_symm {w h} (hw : 0<w) (hh : 0<h) {d e : Dart w h}
    (hs : MapStep hw hh d e) : MapStep hw hh e d := by
  obtain hs | hs := hs
  · exact Or.inl hs.symm
  · exact Or.inr hs.symm

theorem same_tail_map_connected {w h} (hw : 0<w) (hh : 0<h) (d e : Dart w h)
    (ht : d.tail=e.tail) : Walk (MapStep hw hh) (fun _ => True) d e :=
  walk_map (adj := OrbitStep (Dart.rotate hw hh)) (adj' := MapStep hw hh)
    id (fun hs => Or.inl hs) (Dart.same_vertex_connected hw hh d e ht)

/-- Every rectangle dart reaches the origin by actual rotations and reversals. -/
theorem map_connected_to_origin {w h} (hw : 0<w) (hh : 0<h) (d : Dart w h) :
    Walk (MapStep hw hh) (fun _ => True) d (.east ⟨0,hw⟩ ⟨0,by omega⟩) := by
  have hb := d.tail_bounded
  by_cases hx : 0<d.tail.time
  · let a : Dart w h := .west ⟨d.tail.time-1,by omega⟩ ⟨d.tail.depth,by omega⟩
    have ht : d.tail=a.tail := by
      apply point_ext
      · change d.tail.time=d.tail.time-1+1
        omega
      · rfl
    have hm : a.reverse.tail.time+a.reverse.tail.depth<d.tail.time+d.tail.depth := by
      change d.tail.time-1+d.tail.depth<d.tail.time+d.tail.depth
      omega
    exact (same_tail_map_connected hw hh d a ht).trans
      (.step trivial (Or.inr (Or.inl rfl)) (map_connected_to_origin hw hh a.reverse))
  · by_cases hy : 0<d.tail.depth
    · let a : Dart w h := .north ⟨d.tail.time,by omega⟩ ⟨d.tail.depth-1,by omega⟩
      have ht : d.tail=a.tail := by
        apply point_ext
        · rfl
        · change d.tail.depth=d.tail.depth-1+1
          omega
      have hm : a.reverse.tail.time+a.reverse.tail.depth<d.tail.time+d.tail.depth := by
        change d.tail.time+(d.tail.depth-1)<d.tail.time+d.tail.depth
        omega
      exact (same_tail_map_connected hw hh d a ht).trans
        (.step trivial (Or.inr (Or.inl rfl)) (map_connected_to_origin hw hh a.reverse))
    · apply same_tail_map_connected hw hh
      apply point_ext <;> (change _=0) <;> omega
termination_by d.tail.time+d.tail.depth

/-- The full rectangular combinatorial map is connected. -/
theorem rectangle_map_connected {w h} (hw : 0<w) (hh : 0<h) (d e : Dart w h) :
    Walk (MapStep hw hh) (fun _ => True) d e :=
  (map_connected_to_origin hw hh d).trans
    ((map_connected_to_origin hw hh e).reverse (mapStep_symm hw hh))

end StackSorting.GraphWidth.UCurve.PlaneGrid

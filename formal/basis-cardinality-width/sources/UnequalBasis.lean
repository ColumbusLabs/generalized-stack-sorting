import UnequalCasesB

/-! The unequal-width family is an infinite set of minimal forbidden
permutations (basis elements) for generation by the original machine.

`BasisFamily.MinimalForbidden r s n output` (from the reviewed generalized
checkpoint) says that `output` is a permutation of `range n`, that no
unrestricted original `(r,s)` history generates it, and that deleting any
single token leaves an output that some history does generate. -/
namespace StackSorting.Generalized
namespace Unequal
open BasisFamily (delete MinimalForbidden)

variable {r s m : Nat}

/-- Every single-token deletion of the family is generated (§5). The cases
partition the values `0,...,2s+r+2m-1`. -/
theorem all_deletions (hr : 2 ≤ r) (hrs : r < s) (a : Nat) (ha : a < 2*s+r+2*m) :
    Run r s [] (delete a (List.range (2*s+r+2*m))) (delete a (family r s m)) [] := by
  by_cases h₁ : a < r - 1
  · exact del_low hr hrs h₁
  by_cases h₂ : a = r - 1
  · subst h₂; exact del_permanent hr hrs
  by_cases h₃ : a < s
  · exact del_extra hr hrs (by omega) h₃
  by_cases h₄ : a < s+2*r-2+2*m
  · rcases Nat.mod_two_eq_zero_or_one (a-s) with he | ho
    · -- a relay E_k = s + 2k
      have hk : a = s+2*((a-s)/2) := by omega
      rw [hk]
      by_cases hk₁ : (a-s)/2 ≤ r - 2
      · by_cases hkm : (a-s)/2 < m
        · exact del_initRelay_early hr hrs hk₁ hkm
        · exact del_initRelay_late hr hrs hk₁ (by omega)
      · by_cases hkm : (a-s)/2 < m
        · exact del_relayIntro_early hr hrs (by omega) hkm
        · exact del_relayIntro_late hr hrs (by omega) (by omega) (by omega)
    · -- a record s + 1 + 2k
      by_cases hk₁ : (a-s)/2 ≤ r - 2
      · have hk : a = s+1+2*((a-s)/2) := by omega
        rw [hk]
        exact del_lowRecord hr hrs hk₁
      · have hk : a = s+2*r-1+2*((a-s)/2-(r-1)) := by omega
        rw [hk]
        exact del_relayRecord hr hrs (by omega)
  by_cases h₅ : a < 2*s+r+2*m-1
  · exact del_terminal hr hrs (by omega) h₅
  · have h₆ : a = 2*s+r+2*m-1 := by omega
    subst h₆
    exact del_final hr hrs

/-- Every member of the family is a basis element of the class generated by
the original `(r,s)` machine, for all unequal widths `2 <= r < s`. -/
theorem family_minimal (hr : 2 ≤ r) (hrs : r < s) :
    MinimalForbidden r s (2*s+r+2*m) (family r s m) :=
  ⟨family_perm r s m hr hrs, family_not_generated r s m hr hrs,
    fun a ha => all_deletions hr hrs a ha⟩

/-- Infinitely many basis elements for every unequal pair `2 <= r < s`:
basis elements of every length beyond any bound, pairwise distinct in `m`. -/
theorem infinite_basis (hr : 2 ≤ r) (hrs : r < s) (bound : Nat) :
    ∃ m, bound < (family r s m).length ∧
      MinimalForbidden r s (family r s m).length (family r s m) := by
  refine ⟨bound, ?_, ?_⟩
  · rw [family_length r s bound (by omega) (by omega)]; omega
  · rw [family_length r s bound (by omega) (by omega)]
    exact family_minimal hr hrs

/-- Every proper retained-token subset is generated, at the original labels
or after any relabelling (for example standardization). -/
theorem family_proper_patterns (hr : 2 ≤ r) (hrs : r < s) (keep : Nat → Bool)
    (proper : ∃ a, a < 2*s+r+2*m ∧ keep a = false) (f : Nat → Nat) :
    Run r s [] (((List.range (2*s+r+2*m)).filter keep).map f)
      (((family r s m).filter keep).map f) [] :=
  (family_minimal hr hrs).proper_filter_map keep proper f

#print axioms all_deletions
#print axioms family_minimal
#print axioms infinite_basis
#print axioms family_proper_patterns
end Unequal
end StackSorting.Generalized

import EqualDeletion

/-! Infinite bases for equal widths, the sharp capacity threshold, and the
combined classification for widths at least two.

`MinimalForbidden`, `SortMinimal`, `MinimalForbiddenH`, `SortMinimalH`,
`BoundedAt`, `RunH` and the transfer theorems are the reviewed definitions and
results of `../generalized` and `../unequal`, used unchanged. -/
namespace StackSorting.Generalized
namespace Equal
open BasisFamily (delete MinimalForbidden)
open Unequal (lowSeg SortMinimal MinimalForbiddenH SortMinimalH inv length_inv perm_lt_mem std
  std_range genH_delete_iff boundedAt_delete_std lowSeg_bounded all_bounded finite_basis_gen
  finite_basis_sort length_lowSeg)

variable {r k : Nat}

/-- Theorem 1 of the draft, generated side: `A_r(k)` is a basis element of the
class generated by the original `(r,r)` machine. -/
theorem famA_minimal (hr : 3 ≤ r) : MinimalForbidden r r (3*r+7+3*k) (famA r k) :=
  ⟨famA_perm r k hr, famA_not_generated r k hr, fun _ ha => famA_deletion hr ha⟩

theorem famB_minimal (hr : 3 ≤ r) : MinimalForbidden r r (3*r+8+3*k) (famB r k) :=
  ⟨famB_perm r k hr, famB_not_generated r k hr, fun _ ha => famB_deletion hr ha⟩

/-- Theorem 1, sortable side: the inverses are basis elements of the class of
inputs the machine sorts. -/
theorem famA_sortMinimal (hr : 3 ≤ r) : SortMinimal r r (3*r+7+3*k) (inv (famA r k)) :=
  Unequal.MinimalForbidden.toSort (famA_minimal hr)

theorem famB_sortMinimal (hr : 3 ≤ r) : SortMinimal r r (3*r+8+3*k) (inv (famB r k)) :=
  Unequal.MinimalForbidden.toSort (famB_minimal hr)

/-- Every proper retained-token subset of a member is generated, at the
original labels or after any relabelling (for example standardization). -/
theorem famA_proper_patterns (hr : 3 ≤ r) (keep : Nat → Bool)
    (proper : ∃ a, a < 3*r+7+3*k ∧ keep a = false) (f : Nat → Nat) :
    Run r r [] (((List.range (3*r+7+3*k)).filter keep).map f)
      (((famA r k).filter keep).map f) [] :=
  (famA_minimal hr).proper_filter_map keep proper f

theorem famB_proper_patterns (hr : 3 ≤ r) (keep : Nat → Bool)
    (proper : ∃ a, a < 3*r+8+3*k ∧ keep a = false) (f : Nat → Nat) :
    Run r r [] (((List.range (3*r+8+3*k)).filter keep).map f)
      (((famB r k).filter keep).map f) [] :=
  (famB_minimal hr).proper_filter_map keep proper f

/-- For every `r >= 3`, the class generated by the original `(r,r)` machine
has basis elements beyond every length bound. -/
theorem equal_gen_infinite_basis (r : Nat) (hr : 3 ≤ r) (bound : Nat) :
    ∃ p, bound < p.length ∧ MinimalForbidden r r p.length p :=
  ⟨famA r bound, by rw [length_famA r bound hr]; omega,
    by rw [length_famA r bound hr]; exact famA_minimal hr⟩

/-- For every `r >= 3`, the class of inputs sorted by the original `(r,r)`
machine has basis elements beyond every length bound. -/
theorem equal_sort_infinite_basis (r : Nat) (hr : 3 ≤ r) (bound : Nat) :
    ∃ π, bound < π.length ∧ SortMinimal r r π.length π :=
  ⟨inv (famA r bound), by rw [length_inv, length_famA r bound hr]; omega,
    by rw [length_inv, length_famA r bound hr]; exact famA_sortMinimal hr⟩

/-! Capacity: `w(B_r(k)) = r+2`. -/

theorem stepSeg_bounded (hr : 3 ≤ r) : ∀ (c a B : Nat), 3*r+6+3*a ≤ B →
    BoundedAt B (stepSeg r a c) := by
  intro c
  induction c with
  | zero => intro _ _ _; simp [stepSeg, BoundedAt]
  | succ c ih =>
    intro a B h
    rw [stepSeg_succ, boundedAt_append]
    have := qv_lt r a hr
    refine ⟨⟨by omega, by omega, by omega, trivial⟩, ih (a+1) _ (by simp; omega)⟩

theorem famB_boundedAt (hr : 3 ≤ r) : BoundedAt (r+2) (famB r k) := by
  rw [famB_eq, boundedAt_append, boundedAt_append, boundedAt_append]
  refine ⟨lowSeg_bounded r _ 0 _ (by omega), ?_, ?_, ?_⟩
  · simp only [prefixTail, length_lowSeg, BoundedAt]
    refine ⟨by omega, by omega, by omega, by omega, by omega, by omega, trivial⟩
  · exact stepSeg_bounded hr _ 0 _ (by simp [length_lowSeg, prefixTail]; omega)
  · simp only [finB, length_lowSeg, length_stepSeg, prefixTail, List.length_cons,
      List.length_nil, List.cons_append, BoundedAt]
    refine ⟨by omega, by omega, by omega, by omega, all_bounded _ (fun x hx => ?_)⟩
    rcases List.mem_append.mp hx with hx | hx
    · have := queue_bound hr hx; omega
    · simp at hx; omega

/-- Every single deletion of `B_r(k)` is generated within capacity `r+2`. -/
theorem famB_deletion_capacity (hr : 3 ≤ r) (a : Nat) (ha : a < 3*r+8+3*k) :
    RunH r r (r+2) [] (delete a (List.range (3*r+8+3*k))) (delete a (famB r k)) [] := by
  have hrun := famB_deletion (k := k) hr ha
  have hstd := hrun.map (std a)
  simp only [List.map_nil] at hstd
  rw [std_range ha] at hstd
  have hb := boundedAt_delete_std (a := a) (famB r k) (r+2) (famB_boundedAt hr)
    (perm_lt_mem (famB_perm r k hr) ha) (famB_nodup r k hr)
  exact (genH_delete_iff ha).mpr (Run.capacity hstd hb)

/-- `B_r(k)` is a capacity-`H` basis element for every `H >= r+2`. -/
theorem famB_minimalH {H : Nat} (hr : 3 ≤ r) (hH : r + 2 ≤ H) :
    MinimalForbiddenH r r H (3*r+8+3*k) (famB r k) :=
  ⟨famB_perm r k hr, fun h => famB_not_generated r k hr h.toRun,
    fun a ha => (famB_deletion_capacity hr a ha).mono hH⟩

/-- **Sharp threshold for equal widths** (Theorem 2 of the draft). For every
`r >= 3` and every capacity `H`:
- if `H <= r+1`, every capacity-`H` basis element of either class has length
  exactly `H+1`;
- if `H >= r+2`, both capacity-`H` classes have basis elements beyond every
  length bound. -/
theorem capacity_threshold_equal (r H : Nat) (hr : 3 ≤ r) :
    (H ≤ r + 1 →
      (∀ n p, MinimalForbiddenH r r H n p → n = H + 1) ∧
      (∀ n π, SortMinimalH r r H n π → n = H + 1)) ∧
    (r + 2 ≤ H →
      (∀ bound, ∃ p, bound < p.length ∧ MinimalForbiddenH r r H p.length p) ∧
      (∀ bound, ∃ π, bound < π.length ∧ SortMinimalH r r H π.length π)) := by
  have hmax : max r r = r := Nat.max_self r
  refine ⟨fun hH => ⟨fun n p h => ((finite_basis_gen (by omega) (by omega)
      (by rw [hmax]; exact hH)).mp h).2.1,
    fun n π h => ((finite_basis_sort (by omega) (by omega)
      (by rw [hmax]; exact hH)).mp h).2.1⟩, fun hH => ⟨fun bound => ?_, fun bound => ?_⟩⟩
  · exact ⟨famB r bound, by rw [length_famB r bound hr]; omega,
      by rw [length_famB r bound hr]; exact famB_minimalH hr hH⟩
  · exact ⟨inv (famB r bound), by rw [length_inv, length_famB r bound hr]; omega,
      by rw [length_inv, length_famB r bound hr]; exact (famB_minimalH hr hH).toSort⟩

/-! The combined statements for all widths at least two. -/

/-- **Infinite bases.** For all widths `r,s >= 2` other than `r = s = 2`, both
the class generated by one original `(r,s)` machine and the class of inputs it
sorts have basis elements beyond every length bound. Unequal widths are
`Unequal.gen_infinite_basis`/`sort_infinite_basis`; equal widths `r >= 3` are
the families above. (The case `r = s = 2`, whose basis is finite, and the cases
with a width `1` are prior literature and are not formalized here.) -/
theorem infinite_basis_classification (r s : Nat) (hr : 2 ≤ r) (hs : 2 ≤ s)
    (hne : ¬ (r = 2 ∧ s = 2)) :
    (∀ bound, ∃ p, bound < p.length ∧ MinimalForbidden r s p.length p) ∧
    (∀ bound, ∃ π, bound < π.length ∧ SortMinimal r s π.length π) := by
  by_cases hrs : r = s
  · subst hrs
    exact ⟨equal_gen_infinite_basis r (by omega), equal_sort_infinite_basis r (by omega)⟩
  · exact ⟨Unequal.gen_infinite_basis r s hr hs hrs, Unequal.sort_infinite_basis r s hr hs hrs⟩

/-- **Sharp capacity threshold** for all widths `r,s >= 2` other than
`r = s = 2`: capacity-`H` bases are finite (every element has length `H+1`)
exactly up to `H = max(r,s)+1`, and infinite from `H = max(r,s)+2`. -/
theorem capacity_threshold_classification (r s H : Nat) (hr : 2 ≤ r) (hs : 2 ≤ s)
    (hne : ¬ (r = 2 ∧ s = 2)) :
    (H ≤ max r s + 1 →
      (∀ n p, MinimalForbiddenH r s H n p → n = H + 1) ∧
      (∀ n π, SortMinimalH r s H n π → n = H + 1)) ∧
    (max r s + 2 ≤ H →
      (∀ bound, ∃ p, bound < p.length ∧ MinimalForbiddenH r s H p.length p) ∧
      (∀ bound, ∃ π, bound < π.length ∧ SortMinimalH r s H π.length π)) := by
  by_cases hrs : r = s
  · subst hrs
    rw [Nat.max_self]
    exact capacity_threshold_equal r H (by omega)
  · exact Unequal.capacity_threshold r s H hr hs hrs


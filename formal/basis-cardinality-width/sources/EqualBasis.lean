#print axioms famB_minimal
#print axioms famA_sortMinimal
#print axioms famB_sortMinimal
#print axioms equal_gen_infinite_basis
#print axioms equal_sort_infinite_basis
#print axioms famB_minimalH
#print axioms capacity_threshold_equal
#print axioms infinite_basis_classification
#print axioms capacity_threshold_classification
end Equal
